{
  "title": "Hermes Forecast API Overview",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(hermes_http_requests_total[1m])) by (path)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 request latency",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(hermes_http_request_duration_seconds_bucket[5m])) by (le, path))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "429 rate limit rejections",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(hermes_http_requests_total{status=\"429\"}[1m]))" }
      ]
    }
  ]
}
